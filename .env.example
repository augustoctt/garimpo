# Configure estas variaveis no provedor de hospedagem.
DB_HOST=seu-host-mysql
DB_NAME=agenda_viva
DB_USER=agenda_app
DB_PASS=sua-senha-forte
DB_PORT=3306

# O Railway também fornece estes nomes automaticamente no serviço MySQL:
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# Ou uma URL unica: MYSQL_URL=mysql://usuario:senha@host:3306/banco
